# Backend Environment Configuration
# Copy this file to .env and update with your actual values
# SECURITY: Never commit .env file to version control

# ============================================
# API Configuration
# ============================================
PROJECT_NAME="Aegis - SRE - Guardian"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ============================================
# Server Configuration
# ============================================
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ============================================
# AMD Droplet Configuration
# ============================================
# Replace with your actual AMD droplet IP address
AMD_DROPLET_IP="YOUR_DROPLET_IP_HERE"
AMD_DROPLET_PORT=9100

# ============================================
# SSH Configuration for Real Remediation
# ============================================
# RECOMMENDED: Use SSH key authentication
AMD_SSH_KEY_PATH=""  # e.g., /home/user/.ssh/id_ed25519 or C:/Users/user/.ssh/id_ed25519
AMD_SSH_KEY_PASSPHRASE=""  # Leave empty if key has no passphrase

# FALLBACK: Password authentication (less secure, not recommended for production)
AMD_SSH_PASSWORD=""  # Leave empty if using SSH key
AMD_SSH_USER="root"

# SSH Connection Settings
SSH_TIMEOUT=10  # Connection timeout in seconds
SSH_COMMAND_TIMEOUT=30  # Command execution timeout in seconds

# ============================================
# Monitoring Thresholds
# ============================================
CPU_THRESHOLD_PERCENT=70.0
RAM_THRESHOLD_PERCENT=85.0
DISK_THRESHOLD_PERCENT=80.0
METRICS_CHECK_INTERVAL=5  # Seconds between metric checks

# Alert Configuration
ENABLE_REAL_METRICS_MONITORING=false  # Set to true to enable continuous monitoring
ALERT_COOLDOWN_SECONDS=30  # Minimum time between alerts for same incident type

# ============================================
# Vector Store Configuration
# ============================================
VECTORSTORE_DIR="./vectorstore"
VECTOR_DB_COLLECTION="incidents"
VECTOR_EMBEDDING_MODEL="all-MiniLM-L6-v2"  # Sentence transformer model

# ============================================
# LLM Configuration
# ============================================
# For AI-powered diagnosis and remediation suggestions
LLM_MODEL_NAME="llama-3.1-8b"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=4096

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE="./logs/sre_guardian.log"  # Optional: log to file

# ============================================
# Post-mortem Configuration
# ============================================
POSTMORTEM_DIR="./post_mortems"
POSTMORTEM_TEMPLATE="default"
POSTMORTEM_INCLUDE_METRICS=true
POSTMORTEM_INCLUDE_LOGS=true

# ============================================
# Agent Configuration
# ============================================
AGENT_TIMEOUT=60  # Maximum time for agent execution in seconds
AGENT_MAX_RETRIES=3  # Number of retries for failed operations

# ============================================
# Future Integrations (Optional)
# ============================================
# Database (for persistent storage)
# DATABASE_URL="postgresql://user:password@localhost:5432/sre_guardian"

# Redis (for caching and pub/sub)
# REDIS_URL="redis://localhost:6379/0"

# Slack Integration (for alerts)
# SLACK_WEBHOOK_URL=""
# SLACK_CHANNEL="#incidents"

# PagerDuty Integration
# PAGERDUTY_API_KEY=""
# PAGERDUTY_SERVICE_ID=""

# Email Notifications
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# ALERT_EMAIL_TO=""
