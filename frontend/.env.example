# Frontend Environment Configuration
# Copy this file to .env for local development
# Vite exposes variables prefixed with VITE_ to the client

# ============================================
# Backend API Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8000
VITE_API_V1_URL=http://localhost:8000/api/v1

# ============================================
# WebSocket Configuration
# ============================================
VITE_WS_LOGS_URL=ws://localhost:8000/api/v1/logs
VITE_WS_AGENTS_URL=ws://localhost:8000/api/v1/agents

# WebSocket Reconnection Settings
VITE_WS_RECONNECT_INTERVAL=3000  # Milliseconds
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# ============================================
# Application Configuration
# ============================================
VITE_APP_NAME="Aegis - SRE Guardian"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Autonomous Incident Response System"

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_REAL_METRICS=false  # Enable real-time metrics monitoring
VITE_ENABLE_DEBUG_MODE=false  # Show debug information in console
VITE_ENABLE_NOTIFICATIONS=true  # Browser notifications for incidents

# ============================================
# Refresh Intervals (milliseconds)
# ============================================
VITE_METRICS_REFRESH_INTERVAL=5000  # How often to fetch metrics
VITE_HISTORY_REFRESH_INTERVAL=10000  # How often to refresh incident history
VITE_HEALTH_CHECK_INTERVAL=30000  # Backend health check interval

# ============================================
# UI Configuration
# ============================================
VITE_MAX_LOG_ENTRIES=100  # Maximum log entries to display
VITE_MAX_TIMELINE_ITEMS=50  # Maximum timeline items to show
VITE_CHART_DATA_POINTS=20  # Number of data points in charts

# ============================================
# Production Configuration
# ============================================
# For production deployment, update these values:
# VITE_API_BASE_URL=https://your-api-domain.com
# VITE_API_V1_URL=https://your-api-domain.com/api/v1
# VITE_WS_LOGS_URL=wss://your-api-domain.com/api/v1/logs
# VITE_WS_AGENTS_URL=wss://your-api-domain.com/api/v1/agents
